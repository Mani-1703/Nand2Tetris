    Or(a=or01 , b=in[2] , out=or012 ); // taking output of or01 to "Or" with bit 2 
    Or(a=or012 , b=in[3] , out=or0123 ); //... so on
    Or(a=or0123 , b=in[4] , out=or01234 );
