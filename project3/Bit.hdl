// File name: projects/3/a/Bit.hdl
/**
 * 1-bit register:
 * If load is asserted, the register's value is set to in;
 * Otherwise, the register maintains its current value:
 * if (load(t)) out(t+1) = in(t), else out(t+1) = out(t)
 */
CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    Mux(a=Dffout , b=in , sel=load , out=Muxout );// my load has to be 1, to pass the prev in, so b = in
    DFF(in=Muxout , out=Dffout );

    // since we cant use out pin in input ( in Mux (a=) we are creating a separate port
    And(a=Dffout , b=Dffout , out=out ); // at this point we only need to pass Dffout to out - so we can use 
    // an and gate or an Or gate 

}