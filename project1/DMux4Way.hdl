// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    //draw truth table - get the expression
    Not(in=sel[0] , out=sel0bar );
    Not(in=sel[1] , out=sel1bar );
    And(a=sel1bar , b=sel0bar , out=sela );
    And(a=sela , b=in , out=a ); // a = in . sel1' . sel0' 
    And(a=sel1bar , b=sel[0] , out=selb );
    And(a=selb , b=in , out=b ); // b = in . sel1' . sel0 
    And(a=sel[1] , b=sel0bar , out=selc );
    And(a=selc , b=in , out=c ); // c = in . sel1 . sel0' 
    And(a=sel[1] , b=sel[0] , out=seld );
    And(a=seld , b=in , out=d ); // d = in . sel1 . sel0
    
}